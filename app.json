// app.json
{
  "expo": {
    "name": "CineJoy",
    "slug": "cinejoy",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cinejoy.app",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "package": "com.cinejoy.app",
      "permissions": ["INTERNET"]
    }
  }
}